# ONE settings file for the whole project.
#   1. Copy it:           cp .env.example .env
#   2. Fill the values you need in .env (it is git-ignored; this example is committed, so keep real values OUT of it).
#   3. Load it:           set -a; source .env; set +a
#   4. Run Terraform:     terraform -chdir=deploy/terraform/cloud init -backend-config="bucket=${TF_VAR_project_id}-tfstate" -backend-config="prefix=food/cloud"
#                         terraform -chdir=deploy/terraform/cloud apply
# Values that contain a dollar sign (the password hash) must stay inside single quotes.
# Local Docker Compose reads only the "local stack" section of this file (--env-file .env.example).

# ---------------------------------------------------------------- 1. Google Cloud and Terraform (TF_VAR_* are read by Terraform)
TF_VAR_project_id=your-gcp-project-id
TF_VAR_region=asia-south1
TF_VAR_zone=asia-south1-a
TF_VAR_prefix=food
# Hostname for the web UI. Needs to point at the load balancer IP once it exists.
# Empty = use <ip>.sslip.io, a free HTTPS-capable name. Set your own domain to override.
TF_VAR_public_host=
# true stops GKE nodes and Cloud SQL (apply again with false to resume). Dataproc keeps running.
TF_VAR_paused=false
# Your public IP as x.x.x.x/32. It is the only address allowed to reach the cluster API.
TF_VAR_admin_cidr=0.0.0.0/32
TF_VAR_git_repository=https://github.com/OWNER/REPO.git
TF_VAR_git_revision=main
TF_VAR_image_tag=demo-1
# true builds and pushes the images during apply (needs Docker running); false skips the builds.
TF_VAR_build_artifacts=false
# macOS Docker Desktop only: Terraform's Docker provider looks in /var/run, Docker Desktop keeps its socket here.
# DOCKER_HOST=unix:///Users/<you>/.docker/run/docker.sock
# demo is the small, low-cost sizing. standard needs the owner's agreement.
TF_VAR_compute_profile=demo
# Kafka is Apache Kafka on a Compute Engine VM created by Terraform; nothing to fill in here.

# Teardown switches. Leave them as they are normally. To tear the platform down:
#   1. set all three, then apply once (only in-place changes)  2. clear any stuck Argo CD syncs  3. terraform destroy
# Never run a plain apply after a partial destroy: it would re-create what was removed.
# TF_VAR_deletion_protection=false
# TF_VAR_force_destroy_buckets=true
# TF_VAR_firestore_delete_on_destroy=true

# ---------------------------------------------------------------- 2. Secrets (fill in .env only)
# Web UI login for the demo.
TF_VAR_operator_user=demo
# Chosen passphrase, kept here only so you can look it up. Terraform does not read it.
OPERATOR_PASSPHRASE=
# Hash of the passphrase. Create it with:
#   python3 -c 'from werkzeug.security import generate_password_hash as g; print(g("YOUR-PASSPHRASE"))'
TF_VAR_operator_password_hash=''

# ---------------------------------------------------------------- 3. Application settings (when running a service by hand)
APP_ENV=production
PROJECT_ID=your-gcp-project-id
DB_USER=customer_service_user
DB_PASSWORD=
DB_PRIVATE_IP=127.0.0.1
DB_PORT=3306
DB_NAME=orders_db
KAFKA_SECURITY_PROTOCOL=SASL_SSL
KAFKA_BOOTSTRAP_SERVERS=
KAFKA_API_KEY=
KAFKA_API_SECRET=
ZK_HOSTS=127.0.0.1:2181

# ---------------------------------------------------------------- 4. Local stack (Docker Compose). Public development defaults, not cloud credentials.
LOCAL_DB_PASSWORD=local-db-only
LOCAL_DB_ROOT_PASSWORD=local-root-only
LOCAL_MYSQL_PORT=3307
LOCAL_FIRESTORE_PORT=8080
LOCAL_KAFKA_PORT=29092
LOCAL_ORDER_PORT=8081
LOCAL_CUSTOMER_PORT=8083
LOCAL_DELIVERY_PORT=8082
LOCAL_RESTAURANT_PORT=50051
LOCAL_RESTAURANT_HTTP_PORT=8084
LOCAL_TASK_PORT=8085
LOCAL_PAYMENT_PORT=8086
LOCAL_KITCHEN_PORT=8087
LOCAL_NOTIFICATION_PORT=8088
LOCAL_WEB_PORT=3000

# Demo only: view Argo CD read-only without logging in (reachable by port-forward only).
# TF_VAR_argocd_anonymous_view=false
# Address that receives alert emails (leave empty for none).
# TF_VAR_alert_email=
