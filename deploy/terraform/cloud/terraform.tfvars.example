# Copy to terraform.tfvars (git-ignored) and fill in. Real secrets do NOT go in this file:
# set them as environment variables instead, so they never touch disk or git:
#
#   export TF_VAR_kafka_api_key=...            # Confluent key the applications use
#   export TF_VAR_kafka_api_secret=...
#   export TF_VAR_kafka_admin_api_key=...      # Confluent topic-administrator key
#   export TF_VAR_kafka_admin_api_secret=...
#   export TF_VAR_operator_password_hash="$(python3 -c 'from werkzeug.security import generate_password_hash as g; import getpass; print(g(getpass.getpass("Operator passphrase (16+ chars): ")))')"

project_id      = "your-project-id"
region          = "asia-south1"
zone            = "asia-south1-a"
prefix          = "food"
public_host     = "food.example.com"
dns_zone        = "" # name of an existing Cloud DNS zone, or empty to create the A record yourself
admin_cidr      = "203.0.113.10/32" # your public IP, allowed to reach the GKE API
operator_user   = "operator"
image_tag       = "v1"
compute_profile = "demo"

kafka_bootstrap     = "pkc-xxxxx.asia-south1.gcp.confluent.cloud:9092"
kafka_cluster_id    = "lkc-xxxxx"
kafka_rest_endpoint = "https://pkc-xxxxx.asia-south1.gcp.confluent.cloud:443"

git_repository = "https://github.com/OWNER/REPO.git"
git_revision   = "iac-integration"

# build_artifacts = false  # set when the images and jar were already published
# alert_notification_channels = ["projects/your-project-id/notificationChannels/1234567890"]
