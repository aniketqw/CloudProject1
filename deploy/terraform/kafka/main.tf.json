{
  "terraform": {
    "required_version": ">=1.6.0",
    "required_providers": {
      "confluent": {
        "source": "confluentinc/confluent",
        "version": "2.50.0"
      }
    },
    "backend": {
      "gcs": {}
    }
  },
  "variable": {
    "cluster_id": {
      "type": "string"
    },
    "rest_endpoint": {
      "type": "string"
    },
    "kafka_api_key": {
      "type": "string",
      "sensitive": true
    },
    "kafka_api_secret": {
      "type": "string",
      "sensitive": true
    },
    "retention_days": {
      "type": "number",
      "default": 21,
      "validation": {
        "condition": "${var.retention_days >= 7 && var.retention_days <= 30 && floor(var.retention_days) == var.retention_days}",
        "error_message": "Select 7 to 30 whole retention days and keep the pause within the safe margin."
      }
    },
    "topic_partitions": {
      "type": "map(number)",
      "default": {},
      "description": "Existing topic partition counts to preserve during adoption; new topics default to three.",
      "validation": {
        "condition": "${alltrue([for name, count in var.topic_partitions : contains([\"orders\", \"kitchen_status\", \"delivery_assignments\", \"restaurant_analytics_results\"], name) && count >= 1 && floor(count) == count])}",
        "error_message": "Use positive whole partition counts for the four application topics only."
      }
    },
    "topic_configs": {
      "type": "map(map(string))",
      "default": {},
      "description": "Existing writable topic settings to preserve during adoption; retention remains managed by retention_days."
    }
  },
  "resource": {
    "confluent_kafka_topic": {
      "application": {
        "for_each": "${toset([\"orders\",\"kitchen_status\",\"delivery_assignments\",\"restaurant_analytics_results\"])}",
        "topic_name": "${each.value}",
        "partitions_count": "${lookup(var.topic_partitions, each.value, 3)}",
        "config": "${merge(lookup(var.topic_configs, each.value, {}), {\"retention.ms\" = tostring(var.retention_days * 86400000)})}",
        "lifecycle": {
          "prevent_destroy": true
        }
      }
    }
  },
  "provider": {
    "confluent": {
      "kafka_id": "${var.cluster_id}",
      "kafka_rest_endpoint": "${var.rest_endpoint}",
      "kafka_api_key": "${var.kafka_api_key}",
      "kafka_api_secret": "${var.kafka_api_secret}"
    }
  }
}
